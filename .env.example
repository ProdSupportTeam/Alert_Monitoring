APP_NAME=Lumen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
WHATSAPP_AUTH_KEY=
DECRYPT_KEY=

# --- Monitoring alert escalation tiers ---
# Comma-separated WhatsApp numbers per tier. Escalation is cumulative:
#   WARNING  -> TEAM
#   HIGH     -> TEAM + DIRECTOR
#   CRITICAL -> TEAM + DIRECTOR + VP
ALERT_WHATSAPP_TEAM=
ALERT_WHATSAPP_DIRECTOR=
ALERT_WHATSAPP_VP=

# Daily business report (Flight & Hotel)
# Comma-separated WhatsApp recipient numbers for the morning report.
REPORT_WHATSAPP_RECIPIENTS=
# PUBLIC base URL WhatsApp can reach to fetch the generated PDF.
# NOTE: localhost is NOT reachable by WhatsApp - set this to a public HTTPS host.
REPORT_PUBLIC_BASE_URL=

# --- Daily bank CSV report (Flight & Hotel) over email ---
# Comma-separated bank recipient emails.
REPORT_EMAIL_RECIPIENTS=ops@bank.example,alerts@bank.example

# SMTP settings (fill with your real gateway - keep OUT of git).
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@reward360.co
MAIL_FROM_NAME="R360 Monitoring"

